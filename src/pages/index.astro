---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const concepts = [
  {
    id: 'concept-1',
    cls: 'c1',
    trade: 'Pressure washing',
    style: 'Bold, high-contrast, quote-first',
    img: '/concepts/pressure-washing.jpg',
    alt: 'Concept homepage for a fictional pressure-washing business, shown on a phone',
    why: 'Homeowners want a price. The quote button is the first thing they see.',
    local: 'Service towns named up front, so “do you come to me?” is answered instantly.',
  },
  {
    id: 'concept-2',
    cls: 'c2',
    trade: 'Landscaping',
    style: 'Calm, editorial, premium residential',
    img: '/concepts/landscaping.jpg',
    alt: 'Concept homepage for a fictional landscaping business, shown on a phone',
    why: 'Premium clients browse slowly. Big photography, calm type, room to breathe.',
    local: 'Services read like a menu, not a sales pitch.',
  },
  {
    id: 'concept-3',
    cls: 'c3',
    trade: 'Plumbing & HVAC',
    style: 'Trust-forward, tap-to-call up top',
    img: '/concepts/plumbing-hvac.jpg',
    alt: 'Concept homepage for a fictional plumbing and HVAC business, shown on a phone',
    why: 'Emergencies don’t scroll. Tap-to-call sits above everything.',
    local: 'Licensing and service hours are visible immediately.',
  },
];
---

<BaseLayout
  title="Websites for Treasure Coast service businesses"
  description={`See a concept of your new website before you pay anything. Clear, fast, mobile-first sites for local service businesses in ${SITE.serviceArea} — fixed quote, and you own everything.`}
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <p class="eyebrow">Websites for Treasure Coast service businesses</p>
      <h1 id="hero-heading">See your new site <span class="hl">before</span> you pay a dime.</h1>
      <div class="hero-row">
        <p>
          Tell me about your business and I’ll send a one-page concept of your
          homepage — free, no commitment. If you like it, you get a fixed
          written quote. If not, no hard feelings.
        </p>
        <div class="cta-row">
          <a class="btn" href="/contact/">Get my free concept →</a>
          <a class="btn secondary" href="#concepts">See example concepts</a>
        </div>
      </div>
      <ul class="hero-facts" aria-label="The short version">
        <li>From $1,200, fixed in writing</li>
        <li>3–5 focused pages</li>
        <li>Built in Port St. Lucie</li>
        <li>100% yours</li>
      </ul>
    </div>

    <div class="concepts on-dark" id="concepts">
      <input class="concept-input" type="radio" name="concept" id="concept-1" checked />
      <input class="concept-input" type="radio" name="concept" id="concept-2" />
      <input class="concept-input" type="radio" name="concept" id="concept-3" />
      <div class="inner container">
        <div>
          <p class="eyebrow">Example concepts</p>
          <h2>Every trade gets its own look — not a template with your logo swapped in.</h2>
          <p class="sub">Pick a trade to see a concept homepage on a phone, where your customers will actually see it.</p>
          <fieldset class="concept-tabs">
            <legend>Choose an example concept</legend>
            {concepts.map((c) => (
              <label for={c.id}>
                <span><b>{c.trade}</b><span>{c.style}</span></span>
                <i aria-hidden="true">VIEWING</i>
              </label>
            ))}
          </fieldset>
          <p class="honest">
            These are design concepts for fictional businesses — not client
            work. Your concept uses your name, your services, and your area.
          </p>
          <div class="cta-row">
            <a class="btn" href="/contact/">Get a concept of yours</a>
          </div>
        </div>
        <div class="stage">
          {concepts.map((c) => (
            <p class={`note left ${c.cls}`}><b>Why</b>{c.why}</p>
          ))}
          <div class="phone">
            {concepts.map((c, i) => (
              <img
                class={c.cls}
                src={c.img}
                alt={c.alt}
                width="780"
                height="1560"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
          </div>
          {concepts.map((c) => (
            <p class={`note right ${c.cls}`}><b>Detail</b>{c.local}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="how-heading">
    <div class="section-head split">
      <h2 id="how-heading">Three steps. The first one’s free.</h2>
      <p>
        No sales pitch, no retainer, no mystery. You see real work before you
        commit, and a fixed price before anything is built.
      </p>
    </div>
    <ol class="big-steps">
      <li>
        <span class="n" aria-hidden="true">1</span>
        <h3>You tell me about your business</h3>
        <p>A short email: what you do, where you work, and what you want the site to do. I’ll tell you honestly if this package fits.</p>
        <span class="tag-free">Free</span>
      </li>
      <li>
        <span class="n" aria-hidden="true">2</span>
        <h3>I send a free concept</h3>
        <p>A one-page look at your homepage. If you like it, you get a written fixed quote. A 50% deposit books the project.</p>
        <span class="tag-free">Free</span>
      </li>
      <li class="dark">
        <span class="n" aria-hidden="true">3</span>
        <h3>We build it, you watch</h3>
        <p>A private preview link on your phone, two revision rounds, then launch on your domain. You own everything.</p>
      </li>
    </ol>
    <div class="cta-row">
      <a class="btn secondary" href="/process/">See the full process</a>
    </div>
  </section>

  <section class="section container" aria-labelledby="price-heading">
    <div class="receipt-wrap">
      <div>
        <p class="eyebrow">Pricing</p>
        <h2 id="price-heading">One package. One price. In writing.</h2>
        <p>
          I’m early in client work, so founding clients get a lower rate — and
          that rate is locked once you hire me. Standard projects will run
          $1,800–$2,500. What’s crossed off is out of scope on purpose; I’ll
          point you elsewhere rather than improvise.
        </p>
        <div class="cta-row">
          <a class="btn secondary" href="/services/">Everything that’s included</a>
        </div>
      </div>
      <div class="receipt" role="group" aria-labelledby="receipt-heading">
        <h3 id="receipt-heading">STUDIO 772</h3>
        <p class="sub">Founding-client project</p>
        <dl>
          <div><dt>3–5 mobile-first pages</dt><dd>✓</dd></div>
          <div><dt>Copy help — you approve every word</dt><dd>✓</dd></div>
          <div><dt>Local SEO foundations</dt><dd>✓</dd></div>
          <div><dt>Accessibility-conscious build</dt><dd>✓</dd></div>
          <div><dt>2 revision rounds</dt><dd>✓</dd></div>
          <div><dt>Launch, handoff guide, full ownership</dt><dd>✓</dd></div>
          <div class="x"><dt>Online store / booking portal</dt><dd>—</dd></div>
          <div class="x"><dt>Ranking or lead promises</dt><dd>—</dd></div>
        </dl>
        <p class="total"><span>Total, fixed</span><strong>$1,200–$1,500</strong></p>
        <small>50% to book · balance at launch · care plan optional</small>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="who-heading">
    <div class="band on-dark">
      <div>
        <p class="eyebrow">Who you’re working with</p>
        <h2 id="who-heading">One local person, start to finish.</h2>
        <p>
          I’m {SITE.owner}. I’ve lived in Port St. Lucie for over 25 years. The
          person you email is the person who builds your site — no sales team,
          no handoffs.
        </p>
      </div>
      <div class="cta-row">
        <a class="btn secondary" href="/about/">More about me</a>
      </div>
    </div>
  </section>

  <section class="section container closer" aria-labelledby="cta-heading">
    <h2 id="cta-heading">Want to see <span>yours?</span></h2>
    <p>Email me your business name, what you do, and where you work. I’ll reply within one business day.</p>
    <div class="cta-row">
      <a class="btn" href={`mailto:${SITE.email}?subject=Free%20concept%20request`}>Get my free concept →</a>
    </div>
  </section>
</BaseLayout>
