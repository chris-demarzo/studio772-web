---
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource-variable/dm-sans/index.css';
import '../styles/global.css';
import { SITE } from '../site.config';

interface Props {
  /** Page-specific part of the <title>; the site name is appended. */
  title: string;
  /** Unique meta description for this page. */
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;

// Astro.site comes from astro.config.mjs — the single canonical URL boundary.
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const navLinks = [
  ['/', 'Home'],
  ['/services/', 'Services'],
  ['/process/', 'Process'],
  ['/about/', 'About'],
] as const;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f6f2" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={`${title} · ${SITE.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="site-header">
      <div class="container">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>Studio<sup>772</sup></a>
        <nav class="site-nav" aria-label="Primary">
          {navLinks.map(([href, label]) => (
            <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
          ))}
          <a class="nav-cta" href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Get my concept</a>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div>
          <a class="brand" href="/">Studio<sup>772</sup></a>
          <p>
            {SITE.tagline}. Built and maintained
            by {SITE.owner}, serving {SITE.serviceArea}.
          </p>
        </div>
        <nav aria-label="Footer site">
          <h2>Site</h2>
          <ul>
            <li><a href="/services/">Services</a></li>
            <li><a href="/process/">Process</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </nav>
        <nav aria-label="Footer contact">
          <h2>Get in touch</h2>
          <ul>
            <li><a href="/contact/">Get a free concept</a></li>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><a href="/privacy/">Privacy</a></li>
          </ul>
        </nav>
        <div class="footer-legal">
          <span>© {year} {SITE.owner}</span>
          <span>{SITE.serviceArea}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
